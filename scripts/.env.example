# /data/.env — secrets d'environnement docflow (sur la VM, jamais committé)
# Copier vers /data/.env et remplir toutes les valeurs.

# ── Base de données ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://docflow:CHANGE_ME@postgres:5432/docflow

# ── Auth JWT ──────────────────────────────────────────────────────────────────
# Générer : python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# ── Chiffrement (Fernet) ───────────────────────────────────────────────────────
# Sans cette clé, les headers de webhooks, les wallets Harpocrate et les
# secrets utilisateur ne peuvent pas être chiffrés/déchiffrés (silencieusement
# indisponibles). Une fois positionnée, NE PAS changer : les données chiffrées
# deviendraient illisibles.
# Générer : python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# ── Premier accès ──────────────────────────────────────────────────────────────
# Aucun admin n'est pré-créé par variable d'environnement. Le premier compte
# admin se crée via le wizard : POST /api/setup/init-admin (disponible tant
# qu'aucun utilisateur n'existe en base).

# ── Harpocrate (résolution vault://) ──────────────────────────────────────────
# Laisser vide si secrets inline (dev uniquement)
# HARPOCRATE_URL=https://harpocrate.yoops.org

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
